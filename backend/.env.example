# Which broker adapter to use. "alpaca" is implemented.
# "tradezero" is reserved for short selling and returns HTTP 501.
BROKER=alpaca

# Alpaca paper-trading keys.
# Create them at https://app.alpaca.markets/paper/dashboard/overview
# Copy this file to backend/.env and fill these in. Never commit .env.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Paper is the default. Live trading is https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
